{
  "name": "codeling",
  "productName": "Codeling",
  "version": "1.0.0",
  "description": "Learn to code the way you learn a language. A dark, editorial, offline-first desktop trainer with an adaptive lesson engine and a mascot that actually watches you type.",
  "author": {
    "name": "Codeling",
    "email": "hello@codeling.app"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "demo:wizard": "node scripts/build-wizard-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
